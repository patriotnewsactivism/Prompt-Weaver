# Non-secret defaults for the Base44 sandbox dev environment.
#
# This file is listed FIRST in the api service's `env_file:` list in
# docker-compose.base44.yml; the platform-managed secret file
# (/run/base44/app.env) is listed LAST, so any value the user sets in the
# dashboard always wins over what is here.
#
# The API server imports the Gemini and OpenAI integration clients at startup and
# those modules throw when their credentials are missing, so both endpoint URLs need
# a value for the process to boot. They are public endpoints, not secrets.
#
# `lib/integrations-gemini-ai/src/client.ts` sets `httpOptions.apiVersion = ""`,
# which makes @google/genai build request URLs as `<baseUrl>/models/...` (no version
# segment is inserted), so the base URL has to carry the API version itself.
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
